ifconfig eth0 192.168.10.254 netmask 255.255.255.0 up
ifconfig eth1 192.168.30.254 netmask 255.255.255.0 up
ifconfig eth2 203.0.113.254 netmask 255.255.255.0 up

# Abilitiamo l'IP forwarding
sysctl -w net.ipv4.ip_forward=1

# Isoliamo LAN da WAN per simulare una vera architettura
# ma permettiamo da DMZ e WAN l'accesso ai server.

# Configurazione e Avvio Zeek
mkdir -p /shared/zeek_logs
cd /shared/zeek_logs
# 'any' interface lets Zeek listen to all traffic crossing the gateway
nohup zeek -i any > /var/log/zeek_sys.log 2>&1 &
